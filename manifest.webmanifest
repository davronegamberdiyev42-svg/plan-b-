{
  "id": "./",
  "name": "IELTS Boost — Advanced IELTS Learning App",
  "short_name": "IELTS Boost",
  "description": "Final release: 84-day IELTS Academic platform with four mandatory skills, original learning content, 10 laboratories, adaptive practice, verified resource maps and local progress tools.",
  "lang": "uz",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
